+// --------------------------------------------------------------------
+// iOS port: start screen and display scaling (device fix round 2).
+//
+// Opening the app shows a start screen with two controls — a
+// "Launch FEBio" button and a gear-icon settings button beside it
+// — instead of dropping straight into Studio. The settings hold
+// the display scaling: a user-adjustable percentage (75-175%) that
+// replaces the hard-coded 1.15x of patch 0014 and is applied when
+// FEBio launches. It persists in the same settings store the main
+// window uses (IniFormat / UserScope / MRLSoftware / FEBioStudio).
+
+static int iosDisplayScalePercent()
+{
+	QSettings s(QSettings::IniFormat, QSettings::UserScope,
+		QStringLiteral("MRLSoftware"), QStringLiteral("FEBioStudio"));
+	s.beginGroup(QStringLiteral("iOS"));
+	int v = s.value(QStringLiteral("displayScalePercent"), 115).toInt();
+	s.endGroup();
+	return qBound(75, v, 175);
+}
+
+static void iosSetDisplayScalePercent(int v)
+{
+	QSettings s(QSettings::IniFormat, QSettings::UserScope,
+		QStringLiteral("MRLSoftware"), QStringLiteral("FEBioStudio"));
+	s.beginGroup(QStringLiteral("iOS"));
+	s.setValue(QStringLiteral("displayScalePercent"), qBound(75, v, 175));
+	s.endGroup();
+	s.sync();
+}
+
+// The mechanism of patch 0014 (platform font scale + stylesheet
+// sizing), driven by the stored percentage instead of a constant.
+// Deliberately NOT QT_SCALE_FACTOR-style geometry scaling: that
+// would also scale the GL viewport's logical coordinate space and
+// corrupt the picking math. Item rows keep a usable touch size at
+// any setting: patch 0014's 30 px row is the floor and grows with
+// the scale.
+static void iosApplyDisplayScale(int percent)
+{
+	// Always scale from the pristine platform font, so re-applying
+	// after a settings change does not compound.
+	static QFont pristineFont;
+	static bool havePristine = false;
+	if (!havePristine) { pristineFont = QApplication::font(); havePristine = true; }
+
+	const double scale = percent / 100.0;
+	QFont baseFont = pristineFont;
+	if (baseFont.pointSizeF() > 0)
+		baseFont.setPointSizeF(baseFont.pointSizeF() * scale);
+	else
+		baseFont.setPointSizeF(13.0 * scale);
+	QApplication::setFont(baseFont);
+
+	const int rowH = qMax(30, (int)qRound(30.0 * percent / 115.0));
+	const int padV = qMax(2, (int)qRound(3.0 * percent / 115.0));
+	qApp->setStyleSheet(QStringLiteral(
+		"QTreeView::item, QListWidget::item { min-height: %1px; }"
+		"QToolButton, QPushButton { padding-top: %2px; padding-bottom: %2px; }"
+		"QTabBar::tab { padding: %2px 10px; }").arg(rowH).arg(padV));
+}
+
+// A gear icon, painted at runtime: Studio's resource set has no
+// settings/gear artwork to reuse.
+static QIcon iosGearIcon()
+{
+	const int S = 96;
+	QPixmap pm(S, S);
+	pm.fill(Qt::transparent);
+	QPainter p(&pm);
+	p.setRenderHint(QPainter::Antialiasing, true);
+	p.setPen(Qt::NoPen);
+	p.setBrush(QColor(80, 80, 80));
+	p.translate(S / 2.0, S / 2.0);
+	for (int i = 0; i < 8; ++i)
+	{
+		p.save();
+		p.rotate(45.0 * i);
+		p.drawRect(QRectF(-S * 0.07, -S * 0.50, S * 0.14, S * 0.20));
+		p.restore();
+	}
+	p.drawEllipse(QPointF(0, 0), S * 0.34, S * 0.34);
+	p.setCompositionMode(QPainter::CompositionMode_Clear);
+	p.drawEllipse(QPointF(0, 0), S * 0.16, S * 0.16);
+	p.end();
+	return QIcon(pm);
+}
+
+static void iosShowSettings(QWidget* parent)
+{
+	QDialog dlg(parent);
+	dlg.setWindowTitle(QStringLiteral("Settings"));
+
+	QVBoxLayout* lay = new QVBoxLayout(&dlg);
+	lay->setContentsMargins(32, 32, 32, 32);
+	lay->setSpacing(16);
+
+	QLabel* title = new QLabel(QStringLiteral("Display Scaling"));
+	QFont tf = title->font();
+	tf.setBold(true);
+	tf.setPointSizeF(tf.pointSizeF() > 0 ? tf.pointSizeF() + 4 : 20.0);
+	title->setFont(tf);
+	lay->addWidget(title);
+
+	QHBoxLayout* row = new QHBoxLayout;
+	QSlider* slider = new QSlider(Qt::Horizontal);
+	slider->setRange(75, 175);
+	slider->setSingleStep(5);
+	slider->setPageStep(10);
+	QSpinBox* spin = new QSpinBox;
+	spin->setRange(75, 175);
+	spin->setSingleStep(5);
+	spin->setSuffix(QStringLiteral("%"));
+	spin->setMinimumWidth(110);
+	spin->setMinimumHeight(48);
+	const int current = iosDisplayScalePercent();
+	slider->setValue(current);
+	spin->setValue(current);
+	QObject::connect(slider, &QSlider::valueChanged, spin, &QSpinBox::setValue);
+	QObject::connect(spin, QOverload<int>::of(&QSpinBox::valueChanged), slider, &QSlider::setValue);
+	row->addWidget(slider, 1);
+	row->addWidget(spin, 0);
+	lay->addLayout(row);
+
+	QLabel* note = new QLabel(QStringLiteral(
+		"Scales text and controls throughout FEBio Studio.\n"
+		"Applies when FEBio launches."));
+	note->setWordWrap(true);
+	lay->addWidget(note);
+	lay->addStretch(1);
+
+	QHBoxLayout* buttons = new QHBoxLayout;
+	buttons->addStretch(1);
+	QPushButton* cancel = new QPushButton(QStringLiteral("Cancel"));
+	QPushButton* save = new QPushButton(QStringLiteral("Save"));
+	save->setDefault(true);
+	cancel->setMinimumHeight(48);
+	save->setMinimumHeight(48);
+	QObject::connect(cancel, &QPushButton::clicked, &dlg, &QDialog::reject);
+	QObject::connect(save, &QPushButton::clicked, &dlg, &QDialog::accept);
+	buttons->addWidget(cancel);
+	buttons->addWidget(save);
+	lay->addLayout(buttons);
+
+	if (dlg.exec() == QDialog::Accepted)
+		iosSetDisplayScalePercent(spin->value());
+}
+
+// The start screen. Runs before the main window exists; returns
+// when the user launches FEBio (any other dismissal proceeds too —
+// it must never strand the user outside the app).
+static void iosRunLauncher()
+{
+	iosApplyDisplayScale(iosDisplayScalePercent());
+
+	while (true)
+	{
+		QDialog dlg;
+		dlg.setWindowTitle(QStringLiteral("FEBio Studio"));
+
+		QVBoxLayout* lay = new QVBoxLayout(&dlg);
+		lay->setContentsMargins(48, 64, 48, 64);
+
+		QLabel* title = new QLabel(QStringLiteral("FEBio Studio"));
+		QFont tf = title->font();
+		tf.setBold(true);
+		tf.setPointSizeF(tf.pointSizeF() > 0 ? tf.pointSizeF() * 2.0 : 34.0);
+		title->setFont(tf);
+		title->setAlignment(Qt::AlignCenter);
+		lay->addWidget(title);
+		lay->addStretch(1);
+
+		QHBoxLayout* row = new QHBoxLayout;
+		row->setSpacing(16);
+		QPushButton* launch = new QPushButton(QStringLiteral("Launch FEBio"));
+		launch->setMinimumHeight(72);
+		QFont lf = launch->font();
+		lf.setBold(true);
+		lf.setPointSizeF(lf.pointSizeF() > 0 ? lf.pointSizeF() * 1.3 : 20.0);
+		launch->setFont(lf);
+		QToolButton* gear = new QToolButton;
+		gear->setIcon(iosGearIcon());
+		gear->setIconSize(QSize(40, 40));
+		gear->setMinimumSize(72, 72);
+		gear->setToolTip(QStringLiteral("Settings"));
+		QObject::connect(launch, &QPushButton::clicked, &dlg, &QDialog::accept);
+		QObject::connect(gear, &QToolButton::clicked, &dlg, [&dlg]() { dlg.done(2); });
+		row->addWidget(launch, 1);
+		row->addWidget(gear, 0);
+		lay->addLayout(row);
+		lay->addStretch(1);
+
+		const int r = dlg.exec();
+		if (r == 2)
+		{
+			// Settings: persist, then re-apply so the launch that
+			// follows uses the new scale.
+			iosShowSettings(nullptr);
+			iosApplyDisplayScale(iosDisplayScalePercent());
+			continue;
+		}
+		return;
+	}
+}
+#endif
