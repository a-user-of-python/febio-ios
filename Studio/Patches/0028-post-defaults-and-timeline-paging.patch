+int CTimelineWidget::closestDataPointByTime(double t) const
+{
+	int isel = -1;
+	double dmin = 0;
+	for (int i = m_first; i <= m_last; ++i)
+	{
+		double d = fabs(t - m_data[i].ptf.x());
+		if ((isel == -1) || (d < dmin))
+		{
+			isel = i;
+			dmin = d;
+		}
+	}
+	return isel;
+}
+
+//-----------------------------------------------------------------------------
+// Patch 0028 (iOS): window-follows-selection paging. The widget shows a
+// window [m_tmin, m_tmax] of the full time range; points outside the
+// window are drawn off-canvas, so a selection that moves past the
+// window's edge (prev/next buttons, first/last, the state spinbox, a
+// scrub, or the playback playhead - the timeline panel routes all of
+// them through setSelection) used to leave the selected state
+// invisible and made the window's edge indistinguishable from the end
+// of the data. When the selected state's time falls outside the
+// window, shift the window by a whole number of window widths - a
+// page, not a nudge - until the selection is visible, clamped to the
+// data range (panTimeRange clamps). Only the window changes: never
+// the selection and never any value. The range bar's slider is
+// recomputed from (m_tmin, m_tmax) against the full range on every
+// paint (drawRangeBar), so after a page jump it still shows the
+// window's true position and size within the whole.
+void CTimelineWidget::pageWindowToSelection()
+{
+	if (m_data.empty() || (m_nselect < 0)) return;
+
+	double W = m_tmax - m_tmin;
+	double range = m_dataMax - m_dataMin;
+	if ((W <= 0) || (range <= 0) || (W >= range)) return;
+
+	double t = m_data[m_nselect].ptf.x();
+	if ((t >= m_tmin) && (t <= m_tmax)) return;
+
+	if (t > m_tmax)
+	{
+		int pages = (int)ceil((t - m_tmax) / W);
+		if (pages < 1) pages = 1;
+		panTimeRange(-pages * W);
+	}
+	else
+	{
+		int pages = (int)ceil((m_tmin - t) / W);
+		if (pages < 1) pages = 1;
+		panTimeRange(pages * W);
+	}
+	m_tinc = getscale(m_tmin, m_tmax);
+}
