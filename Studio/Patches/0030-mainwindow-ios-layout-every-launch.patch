-			QTimer::singleShot(0, this, [this]() {
+		// Layout version 3 (device fix round 3): versions 1-2
+		// ran this sizing ONCE, gated on the iosLayoutVersion
+		// flag, and trusted the restored state on every later
+		// launch. That cannot hold on iPad: the only writer
+		// of the saved state is closeEvent -> writeSettings,
+		// and iOS's suspend-then-kill lifecycle does not
