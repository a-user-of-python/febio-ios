+//-----------------------------------------------------------------------------
+// Touch support (patch 0012, iOS). The viewport is a QWindow, so
+// multi-touch arrives as QTouchEvent, not as QWidget gestures.
+//
+// Design: one finger is NOT claimed — Qt's synthesized mouse
+// events drive orbit / tap-select exactly as on desktop. The
+// touch layer only (a) arms a long-press timer for the context
+// menu, and (b) claims the sequence when a second finger lands,
+// driving pan / pinch-zoom / two-finger rotate with the same
+// camera calls the mouse and native-gesture paths use.
+//
+// Claiming the sequence ends mouse synthesis for the first
+// finger, so a balancing synthesized mouse release still arrives;
+// m_touchMulti makes mouseReleaseEvent ignore it (otherwise the
+// end of every pinch would be misread as a click-select or an
+// undoable view change).
+//-----------------------------------------------------------------------------
+void CGLView::touchEvent(QTouchEvent* ev)
+{
+	const QList<QTouchEvent::TouchPoint>& pts = ev->points();
+
+	if (ev->type() == QEvent::TouchCancel)
+	{
+		m_longPress->stop();
+		m_touchPrev = false;
+		m_touchMulti = false;
+		m_touchMenu = false;
+		ev->accept();
+		return;
+	}
+
+	if (ev->type() == QEvent::TouchEnd)
+	{
+		m_longPress->stop();
+		if (m_touchMulti)
+		{
+			// Commit the whole gesture as ONE undoable view
+			// change — the same save/restore/redo pattern
+			// mouseReleaseEvent uses (m_oldCam was saved by the
+			// synthesized press that started the sequence).
+			GLScene* scene = GetActiveScene();
+			if (scene)
+			{
+				GLCamera& cam = scene->GetCamera();
+				CCmdChangeView* pcmd = new CCmdChangeView(&cam, cam);
+				cam = m_oldCam;
+				m_Cmd.DoCommand(pcmd);
+				cam.SetMoving(false);
+				update();
+			}
+		}
+		m_touchPrev = false;
+		m_touchMulti = false;
+		m_touchMenu = false;
+		ev->ignore(); // let the final release stay synthesized
+		return;
+	}
+
+	if (pts.size() == 1)
+	{
+		const QTouchEvent::TouchPoint& p = pts.first();
+		if (ev->type() == QEvent::TouchBegin)
+		{
+			// Record the press and arm the long-press timer;
+			// deliberately not accepted (see header comment).
+			m_touchPressPos = p.position();
+			m_longPress->start(450);
+		}
+		else if (ev->type() == QEvent::TouchUpdate)
+		{
+			if (m_longPress->isActive() &&
+				((p.position() - m_touchPressPos).manhattanLength() > 14))
+				m_longPress->stop();
+		}
+		ev->ignore();
+		return;
+	}
+
+	if (pts.size() == 2)
+	{
+		ev->accept(); // claim the sequence; stops mouse synthesis
+		m_longPress->stop();
+		m_touchMulti = true;
+
+		QPointF p0 = pts[0].position();
+		QPointF p1 = pts[1].position();
+		QPointF c = (p0 + p1) * 0.5;
+		double  d = QLineF(p0, p1).length();
+		double  a = QLineF(p0, p1).angle() * 0.01745329; // degrees to rad
+
+		if (m_touchPrev)
+		{
+			GLScene* scene = GetActiveScene();
+			if (scene)
+			{
+				GLCamera& cam = scene->GetCamera();
+
+				// two-finger drag pans (the middle-drag formula)
+				QPointF dc = c - m_touchC;
+				if (!dc.isNull())
+					cam.PanView(vec3d(-dc.x(), dc.y(), 0.0));
+
+				// pinch zooms (Zoom multiplies the target distance:
+				// spreading the fingers must shrink it)
+				if ((m_touchD > 0) && (d > 0))
+					cam.Zoom(m_touchD / d);
+
+				// two-finger rotate orbits in-plane (as the
+				// RotateNativeGesture branch of gestureEvent does)
+				double da = a - m_touchA;
+				while (da >  3.14159265) da -= 2 * 3.14159265;
+				while (da < -3.14159265) da += 2 * 3.14159265;
+				if (da != 0.0)
+				{
+					quatd qz = quatd(-da, vec3d(0, 0, 1));
+					cam.Orbit(qz);
+				}
+
+				cam.Update(true);
+				update();
+			}
+		}
+
+		m_touchC = c;
+		m_touchD = d;
+		m_touchA = a;
+		m_touchPrev = true;
+		return;
+	}
+
+	// three or more points: claim and ignore
+	ev->accept();
+}
+
+void CGLView::OnLongPress()
+{
+	// The press must still be down, single, and nearly stationary
+	// (m_x1/m_y1 track the synthesized mouse position).
+	if (!mouseIsPressed || m_touchMulti || m_touchMenu) return;
+	if ((abs(m_x1 - m_x0) > 14) || (abs(m_y1 - m_y0) > 14)) return;
+
+	m_touchMenu = true; // the release that follows must not select
+
+	QMenu menu(m_pWnd);
+	m_pWnd->BuildContextMenu(menu);
+	menu.exec(mapToGlobal(m_touchPressPos.toPoint()));
+}
