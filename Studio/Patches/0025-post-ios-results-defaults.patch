--- a/FEBioStudio/FEBioStudio.cpp
+++ b/FEBioStudio/FEBioStudio.cpp
@@ -501,8 +501,34 @@ int main(int argc, char* argv[])
 		for (const char* s : samples)
 		{
 			QString dst = docs + "/" + s;
+			QString src = appDir + "/" + s;
 			if (!QFile::exists(dst))
-				QFile::copy(appDir + "/" + s, dst);
+			{
+				QFile::copy(src, dst);
+			}
+			else
+			{
+				// Patch 0025: the two bundled samples are app-managed
+				// demo content, not user files. If an upgrade ships a
+				// new version of a sample, replace the stale seeded
+				// copy, so the demo that auto-opens is the demo this
+				// build bundles. Only these two sample names are ever
+				// refreshed; everything else in this folder - the
+				// README and all of the user's own files - is seeded
+				// once and never overwritten.
+				QFile fs(src), fd(dst);
+				if (fs.open(QIODevice::ReadOnly) && fd.open(QIODevice::ReadOnly))
+				{
+					QByteArray bs = fs.readAll();
+					QByteArray bd = fd.readAll();
+					fs.close(); fd.close();
+					if (bs != bd)
+					{
+						QFile::remove(dst);
+						QFile::copy(src, dst);
+					}
+				}
+			}
 		}
 
