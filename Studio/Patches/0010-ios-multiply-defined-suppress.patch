diff --git a/CMakeLists.txt b/CMakeLists.txt
index 4849a19..d9fc78d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -646,6 +646,16 @@ if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
 	# functions explicitly. Link the single-threaded stub that
 	# the device-verified spike used for the same symbols.
 	target_sources(FEBioStudio PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/FEBioStudio/iOSOmpStub.c)
+	# iOS port (patch 0010): Studio vendors copies of a few FEBio
+	# sources (MeshTools/QuadricFit.cpp, MeshTools/FENNQuery.cpp)
+	# and both sides define a free fact(int) (FEAMR vs ImageLib).
+	# With everything statically linked — and the FEBio archives
+	# force-loaded above — the linker sees 16 duplicate symbols.
+	# On desktop this never collides because FEBio links as
+	# shared libraries. The duplicated classes have identical
+	# layouts (only FEBio-API renames differ), so keep the first
+	# definition, like the dynamic linker would.
+	target_link_options(FEBioStudio PRIVATE "-Wl,-multiply_defined,suppress")
 endif()
 
 if(WIN32)
