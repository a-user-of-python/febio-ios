 void CMainWindow::on_actionVolumeRender_triggered()
 {
+#ifdef Q_OS_IOS
+	// iOS port (patch 0024): volume rendering draws through 3D
+	// textures, which the Metal backend does not provide in this
+	// build (patch 0011 made the path a safe no-op). Say so
+	// instead of silently adding a renderer that draws nothing.
+	QMessageBox::information(this, "FEBio Studio",
+		"Volume rendering is not available in the iOS build yet.\n\n"
+		"It renders image volumes through 3D textures, which the Metal "
+		"graphics backend does not provide. Surface and mesh rendering "
+		"are unaffected.");
+	return;
+#endif
+
 	// get the document
 	CDocument* modelDoc = GetModelDocument();
 	CDocument* postDoc = GetPostDocument();
