+#ifdef Q_OS_IOS
+	// iOS port (patch 0024): identify the port and its limits in
+	// the one place every user can find them.
+	txt += QString(
+		"<p><b>iOS port rc1</b> (unofficial). The FEBio 4.13 solver runs "
