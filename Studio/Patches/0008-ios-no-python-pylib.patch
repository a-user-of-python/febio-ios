+// iOS port (patch 0008): there is no CPython interpreter on iOS,
+// so the pybind11 implementation below cannot build or run. The
+// class interface (used by the Python editor window) is preserved
+// with a stub: scripts simply report failure immediately, exactly
+// like a desktop build with no working Python. The desktop
+// implementation follows unchanged in the #else branch.
+#ifdef Q_OS_IOS
+#include "PythonRunner.h"
+#include <string>
+
+CPythonRunner* CPythonRunner::m_This = nullptr;
+
+CPythonRunner::CPythonRunner(QObject* parent) : QObject(parent), m_pythonHome(L"")
+{
+	m_This = this;
+}
+
+CPythonRunner::~CPythonRunner()
+{
+	if (m_This == this) m_This = nullptr;
+}
+
+CPythonRunner* CPythonRunner::GetInstance()
+{
+	return m_This;
+}
+
+bool CPythonRunner::isBusy() const { return false; }
+
+void CPythonRunner::interrupt() {}
+
+void CPythonRunner::SetWorkingDirectory(QString cwd) { m_cwd = cwd.toStdString(); }
+
+void CPythonRunner::runScript(QString) { emit runScriptFinished(false); }
+
+void CPythonRunner::setPythonCWD(const std::string&) {}
+
+#else
 #include <pybind11/pybind11.h>
 #include <pybind11/embed.h>
 #include "PythonRunner.h"
@@ -133,3 +171,5 @@ void CPythonRunner::setPythonCWD(const std::string& cwd)
 	py::module_::import("os").attr("chdir")(cwd);
 #endif
 }
+
+#endif // Q_OS_IOS (iOS port, patch 0008)
