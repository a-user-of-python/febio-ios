+++ b/CMakeLists.txt
@@ -363,6 +363,16 @@ foreach(name IN LISTS FEBIOSTUDIO_LIBS)
 	findHdrSrc(${name})
 endforeach(name)
 
+if(CMAKE_SYSTEM_NAME STREQUAL "iOS")
+	# iOS port (patch 0008): no CPython exists on iOS. PyLib's
+	# PyFBS*.cpp register the pybind11 module and cannot compile
+	# without Python headers. Nothing outside PyLib references
+	# them — PythonRunner is their only caller, and it is stubbed
+	# on iOS (see PyLib/PythonRunner.cpp) — so build PyLib from
+	# the remaining sources only.
+	list(FILTER SRC_PyLib EXCLUDE REGEX "PyFBS")
+endif()
