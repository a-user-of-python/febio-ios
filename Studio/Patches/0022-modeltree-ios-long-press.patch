+#ifdef Q_OS_IOS
+//-----------------------------------------------------------------------------
+// iOS port (patch 0022): press-and-hold on the tree opens the
+// context menu. Only synthesized (touch) presses arm the timer;
+// mouse and trackpad keep the platform's right-click behaviour.
+// Movement beyond the tap deadzone or an early release cancels.
+void CModelTree::mousePressEvent(QMouseEvent* ev)
+{
+	QTreeWidget::mousePressEvent(ev);
+
+	if (ev->source() == Qt::MouseEventSynthesizedBySystem)
+	{
+		m_lpPressed = true;
+		m_lpGlobalPos = ev->globalPosition().toPoint();
+		m_lpTimer->start(450);
+	}
+}
+
+void CModelTree::mouseMoveEvent(QMouseEvent* ev)
+{
+	QTreeWidget::mouseMoveEvent(ev);
+
+	if (m_lpPressed &&
+		((ev->globalPosition().toPoint() - m_lpGlobalPos).manhattanLength() > 14))
+		m_lpTimer->stop();
+}
+
+void CModelTree::mouseReleaseEvent(QMouseEvent* ev)
+{
+	m_lpPressed = false;
+	m_lpTimer->stop();
+	QTreeWidget::mouseReleaseEvent(ev);
+}
+#endif
+
