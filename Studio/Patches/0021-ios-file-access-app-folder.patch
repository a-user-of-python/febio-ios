+//-----------------------------------------------------------------------------
+// iOS port (patch 0021): browse the app's shared Documents folder
+// (the folder the Files app shows as "On My iPad > FEBio Studio").
+// Compiled on every platform (moc references the slot); the
+// File-menu action that triggers it only exists on iOS.
+// from inside the app, without the native document picker.
+// "Open" routes through OpenFile (the desktop dispatch: .feb asks
+// model-vs-XML, .xplt opens results, .fsm/.inp/.k/VTK open as
+// documents); "Import Geometry" routes through ImportFiles (the
+// extension-reader registry) so a mesh lands in the active model,
+// ready for materials, boundary conditions and Run.
+void CMainWindow::on_actionAppFolder_triggered()
+{
+	QString docs = QStandardPaths::writableLocation(QStandardPaths::DocumentsLocation);
+
+	// every extension Studio can open as a document or read
+	// through its geometry-import registry (menuFile.cpp's
+	// REGISTER_CLASS4 list)
+	static const char* exts[] = {
+		"fsm", "fs2", "fsprj", "prv", "feb", "xplt", "inp", "n", "dyn", "key", "k",
+		"stl", "vtk", "vtu", "vtp", "vtm", "pvd", "fsps", "log", "txt",
+		"ply", "obj", "dxf", "nas", "unv", "cdb", "msh", "byu", "surf", "hmascii",
+		"mphtxt", "mesh", "ele", "elem", "raw", "pvo",
+		"step", "stp", "iges", "igs", "brep", "brp"
+	};
+	QStringList nameFilters;
+	for (const char* e : exts) nameFilters << QString("*.") + e;
+
+	QDir dir(docs);
+	QStringList files = dir.entryList(nameFilters, QDir::Files, QDir::Name);
+
+	QDialog dlg(this);
+	dlg.setWindowTitle("App Folder");
+	QVBoxLayout* lay = new QVBoxLayout(&dlg);
+
+	QLabel* info = new QLabel(files.isEmpty()
+		? QString("No files yet.\n\nCopy files into the FEBio Studio folder in the Files app\n(On My iPad > FEBio Studio), then open this list again.\nSee README.txt in that folder for the supported file types.")
+		: QString("Files in the FEBio Studio folder (Files > On My iPad > FEBio Studio):"));
+	info->setWordWrap(true);
+	lay->addWidget(info);
+
+	QListWidget* list = new QListWidget;
+	for (const QString& fn : files)
+	{
+		QFileInfo fi(dir.filePath(fn));
+		QListWidgetItem* it = new QListWidgetItem(
+			QString("%1  (%2 KB)").arg(fn).arg((fi.size() + 1023) / 1024));
+		it->setData(Qt::UserRole, dir.filePath(fn));
+		list->addItem(it);
+	}
+	if (list->count() > 0) list->setCurrentRow(0);
+	lay->addWidget(list, 1);
+
+	QHBoxLayout* row = new QHBoxLayout;
+	QPushButton* openBtn = new QPushButton("Open");
+	QPushButton* importBtn = new QPushButton("Import Geometry");
+	QPushButton* closeBtn = new QPushButton("Close");
+	openBtn->setMinimumHeight(48);
+	importBtn->setMinimumHeight(48);
+	closeBtn->setMinimumHeight(48);
+	openBtn->setDefault(true);
+	row->addWidget(openBtn);
+	row->addWidget(importBtn);
+	row->addStretch(1);
+	row->addWidget(closeBtn);
+	lay->addLayout(row);
+
+	connect(closeBtn, &QPushButton::clicked, &dlg, &QDialog::reject);
+	connect(openBtn, &QPushButton::clicked, &dlg, &QDialog::accept);
+	connect(list, &QListWidget::itemDoubleClicked, &dlg, &QDialog::accept);
+	connect(importBtn, &QPushButton::clicked, &dlg, [&dlg]() { dlg.done(2); });
+
+	const int r = dlg.exec();
+	if (r == 0) return;
+
+	QListWidgetItem* cur = list->currentItem();
+	if (cur == nullptr) return;
+	QString path = cur->data(Qt::UserRole).toString();
+	if (path.isEmpty()) return;
+
+	// CAD formats are registered readers, but they need the CAD
+	// toolkit (Open CASCADE + Netgen), which the iOS build does
+	// not include yet — say so plainly instead of failing obscurely.
+	QString ext = QFileInfo(path).suffix().toLower();
+	static const char* cadExts[] = { "step", "stp", "iges", "igs", "brep", "brp" };
+	for (const char* c : cadExts)
+	{
+		if (ext == c)
+		{
+			QMessageBox::information(this, "FEBio Studio",
+				"STEP, IGES and BREP files need the CAD toolkit (Open CASCADE + Netgen), "
+				"which is not part of the iOS build yet.\n\n"
+				"Export the part as STL (or another mesh format) and import that instead: "
+				"an imported mesh can be given materials and boundary conditions, and run like any other model.");
+			return;
+		}
+	}
+
+	if (r == 2) ImportFiles(QStringList(path));
+	else OpenFile(path, false);
+}
